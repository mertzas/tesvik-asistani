# ============================================
# Teşvik Asistanı SaaS - Environment Template
# Copy this file to .env and update values
# ============================================

# DATABASE
# --------
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tesvik_saas
SQLALCHEMY_ECHO=False

# SECURITY
# --------
# Secret key for JWT signing - CHANGE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-chars

# JWT configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# STRIPE PAYMENT
# ---------------
# Stripe API keys - Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# EMAIL CONFIGURATION
# -------------------
# SMTP server settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# For Gmail, generate app-specific password:
# https://myaccount.google.com/apppasswords

# APPLICATION
# -----------
APP_NAME=Teşvik Asistanı SaaS
APP_URL=http://localhost:8000
ENVIRONMENT=development

# TCMB EVDS (Elektronik Veri Dagitim Sistemi)
# ---------------
# Anahtar almak icin: https://evds2.tcmb.gov.tr/index.php?/evds/login (uye ol -> API Anahtari)
EVDS_API_KEY=

# CLAUDE API (Anthropic) - AI destekli teşvik danışmanlığı için
# ---------------
# Anahtar almak icin: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# İKAS ADMIN APP ENTEGRASYONU
# ---------------
# client_id/secret İKAS Builders Dashboard'da uygulama kaydı yapılıp bir
# test mağazası atandıktan sonra elde edilir. Bunlar bos oldugu surece
# IKAS_MOCK_MODE zorunlu olarak devrede kalir (gercek ag cagrisi yapilmaz).
IKAS_CLIENT_ID=
IKAS_CLIENT_SECRET=
IKAS_SCOPE=read_orders read_products
IKAS_MOCK_MODE=true

# REDIS (Optional - for caching)
# -------
REDIS_URL=redis://localhost:6379/0

# LOGGING
# -------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# FEATURES
# --------
# Enable/disable features
ENABLE_WEBHOOKS=true
ENABLE_ANALYTICS=true
ENABLE_RATE_LIMITING=true

# AWS S3 (Optional - for file uploads)
# -----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=tesvik-uploads
AWS_S3_REGION=eu-west-1

# SENTRY (Optional - error tracking)
# ------
SENTRY_DSN=

# GITHUB (Optional - for OAuth)
# ------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GOOGLE (Optional - for OAuth)
# ------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn (Optional - for OAuth)
# --------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
