# Teşvik Asistanı - ortam değişkenleri şablonu
#
#   cp .env.example .env
#
# Bu dosyada YALNIZCA kodun gerçekten okuduğu değişkenler var (doğrulandı
# 2026-09-26). Önceki hali REDIS_URL, SENTRY_DSN, AWS_*, GITHUB/GOOGLE/
# LINKEDIN OAuth, ENABLE_WEBHOOKS/ANALYTICS/RATE_LIMITING gibi hiçbir yerde
# okunmayan ~15 değişken içeriyordu; bunları doldurmak hiçbir şeyi
# değiştirmediği için yeni gelen geliştiriciyi yanlış yöne sürüklüyordu.


# ---------------------------------------------------------------- VERİTABANI
# Yerel geliştirmede SQLite kullanılır, ayrı bir sunucu kurmanız gerekmez.
# Üretimde PostgreSQL: postgresql://kullanici:sifre@host:5432/veritabani
# (psycopg2 yalnızca Docker imajında kurulur, bkz. requirements-postgres.txt)
DATABASE_URL=sqlite:///./data/tesvikler.db


# ------------------------------------------------------------------ GÜVENLİK
# JWT imzalama anahtarı. ÜRETİMDE MUTLAKA DEĞİŞTİRİN:
#     openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30


# ------------------------------------------------------------------ UYGULAMA
# APP_URL OAuth callback adreslerinin türetildiği taban adres; yanlışsa
# İKAS bağlantısı sessizce başarısız olur.
APP_URL=http://localhost:8000
# ENVIRONMENT şu an kodda okunmuyor, yalnızca belgeleyici.
ENVIRONMENT=development
# INFO / DEBUG. DEBUG'da anthropic ve httpcore istek gövdesini basmaz
# (app/logging_setup.py bunları INFO tavanında tutar).
LOG_LEVEL=INFO


# ---------------------------------------------------- CLAUDE API (Anthropic)
# Boş bırakılırsa AI danışman devre dışı kalır ve liste formatına düşülür;
# uygulamanın kalanı çalışır. Anahtar: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5


# ----------------------------------------------------------- TCMB EVDS (veri)
# Bütçe önerisindeki sektör kâr oranları ve enflasyon buradan gelir. Boşsa
# tuik_macro scraper'ı kod içindeki yedek (seed) değerlere düşer.
# Anahtar: https://evds2.tcmb.gov.tr -> üye ol -> API Anahtarı
EVDS_API_KEY=


# ------------------------------------------------------------------- STRIPE
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Abonelik planlarının Stripe'taki price id'leri
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=


# -------------------------------------------------------------------- E-POSTA
# Gmail için uygulama şifresi gerekir: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# ---------------------------------------------------------------------- İKAS
# client_id/secret İKAS CLI ile üretilir:
#     npm i -g ikas && ikas auth login && ikas app init
# İkisi de boş olduğu sürece IKAS_MOCK_MODE zorunlu olarak devrede kalır ve
# hiçbir gerçek ağ çağrısı yapılmaz (bkz. app/ikas_integration.py).
IKAS_CLIENT_ID=
IKAS_CLIENT_SECRET=
IKAS_SCOPE=read_orders read_products
IKAS_MOCK_MODE=true


# ---------------------------------------------- yalnızca docker-compose.prod
# docker-compose.prod.yml bu üçünü PostgreSQL kapsayıcısı için okur.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=tesvik_db
