# Teşvik Asistanı - ortam değişkenleri şablonu
#
#   cp .env.example .env
#
# Bu dosyada YALNIZCA kodun gerçekten okuduğu değişkenler var (doğrulandı
# 2026-09-26). Önceki hali REDIS_URL, SENTRY_DSN, AWS_*, GITHUB/GOOGLE/
# LINKEDIN OAuth, ENABLE_WEBHOOKS/ANALYTICS/RATE_LIMITING gibi hiçbir yerde
# okunmayan ~15 değişken içeriyordu; bunları doldurmak hiçbir şeyi
# değiştirmediği için yeni gelen geliştiriciyi yanlış yöne sürüklüyordu.


# ---------------------------------------------------------------- VERİTABANI
# Yerel geliştirmede SQLite kullanılır, ayrı bir sunucu kurmanız gerekmez.
# Üretimde PostgreSQL: postgresql://kullanici:sifre@host:5432/veritabani
# (psycopg2 yalnızca Docker imajında kurulur, bkz. requirements-postgres.txt)
DATABASE_URL=sqlite:///./data/tesvikler.db


# ------------------------------------------------------------------ GÜVENLİK
# JWT imzalama anahtarı. ÜRETİMDE MUTLAKA DEĞİŞTİRİN (en az 32 karakter; varsayılan/kısa
# anahtarla uygulama AÇILMAZ):
#     openssl rand -hex 32
SECRET_KEY=
# Yalnızca yerel geliştirme: varsayılan/kısa SECRET_KEY ile açılışa (uyarıyla) izin verir.
ALLOW_INSECURE_SECRET=false
# CORS izinli origin'ler, virgülle. Boşsa APP_URL + http://localhost:8000 + http://127.0.0.1:8000.
#     ALLOWED_ORIGINS=https://tesvikasistani.com,https://www.tesvikasistani.com
ALLOWED_ORIGINS=
# Hız sınırı sayaçları: boşsa süreç içi (tek işçi). Çok işçili/çok sunuculu dağıtımda zorunlu:
#     REDIS_URL=redis://redis:6379/0   (docker-compose.prod.yml bunu kendisi verir)
REDIS_URL=
# Zamanlanmış scraper işleri (true/false). Çok işçide yalnızca kilidi alan işçi çalıştırır.
SCHEDULER_ENABLED=true
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7


# ------------------------------------------------------------------ UYGULAMA
# APP_URL OAuth callback adreslerinin türetildiği taban adres; yanlışsa
# İKAS bağlantısı sessizce başarısız olur.
APP_URL=http://localhost:8000
# ENVIRONMENT şu an kodda okunmuyor, yalnızca belgeleyici.
ENVIRONMENT=development
# INFO / DEBUG. DEBUG'da openai ve httpcore istek gövdesini basmaz
# (app/logging_setup.py bunları INFO tavanında tutar).
LOG_LEVEL=INFO


# ------------------------------------------- YANIT SERVİSİ (app/llm_saglayici.py)
# Varsayılan: yerel danışman (dış çağrı yok, veri sunucudan çıkmaz, rıza gerekmez).
# Dış dil modeli isteğe bağlıdır; Anthropic API'si kullanılmaz (2026-10-11).
#   LLM_SAGLAYICI=gemini          LLM_API_KEY zorunlu (https://aistudio.google.com/apikey), LLM_MODEL isteğe bağlı
#   LLM_SAGLAYICI=openai_uyumlu   LLM_BASE_URL + LLM_MODEL zorunlu; LLM_KURUM/LLM_ULKE KVKK metninde gösterilir;
#                                 sunucu Türkiye'deyse LLM_YURTDISI=false (yurt dışı aktarımı yok, rıza gerekmez)
LLM_SAGLAYICI=yerel
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=


# ----------------------------------------------------------- TCMB EVDS (veri)
# Bütçe önerisindeki sektör kâr oranları ve enflasyon buradan gelir. Boşsa
# tuik_macro scraper'ı kod içindeki yedek (seed) değerlere düşer.
# Anahtar: https://evds2.tcmb.gov.tr -> üye ol -> API Anahtarı
EVDS_API_KEY=


# ------------------------------------------------------------------- STRIPE
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Abonelik planlarının Stripe'taki price id'leri
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=


# -------------------------------------------------------------------- E-POSTA
# Gmail için uygulama şifresi gerekir: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP çalıştıktan SONRA true yapın: kayıt e-posta doğrulamasına bağlanır, kayıt yanıtı hesap var/yok
# ayrımını sızdırmaz. Açıkken doğrulanmamış hesaplar giriş yapamaz (girişte bağlantı yeniden gönderilir).
KAYIT_EPOSTA_DOGRULAMA_ZORUNLU=false


# -------------------------------------------------------------- HATA İZLEME
# Boşsa kapalı. Sentry projesinin DSN'i; KVKK için AB bölgesi (…ingest.de.sentry.io) tercih edin ve aydınlatma
# metnine ekleyin. İstek gövdesi, çerez, Authorization ve yerel değişkenler gönderilmez (app/hata_izleme.py).
SENTRY_DSN=
SENTRY_ORTAM=production


# ---------------------------------------------------------------------- İKAS
# client_id/secret İKAS CLI ile üretilir:
#     npm i -g ikas && ikas auth login && ikas app init
# İkisi de boş olduğu sürece IKAS_MOCK_MODE zorunlu olarak devrede kalır ve
# hiçbir gerçek ağ çağrısı yapılmaz (bkz. app/ikas_integration.py).
IKAS_CLIENT_ID=
IKAS_CLIENT_SECRET=
IKAS_SCOPE=read_orders read_products
IKAS_MOCK_MODE=true


# ---------------------------------------------- yalnızca docker-compose.prod
# docker-compose.prod.yml bu üçünü PostgreSQL kapsayıcısı için okur.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=tesvik_db
