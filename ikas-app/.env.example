# Kabuğun kendi sırrı yok: İKAS client secret yalnızca FastAPI .env'sinde (IKAS_CLIENT_SECRET) durur.
# FastAPI adresi. Tanımlıysa /api/* ve /kvkk oraya iletilir (yerel geliştirme / nginx'siz kurulum).
BACKEND_URL=http://127.0.0.1:8000
# İKAS panelinin kökenleri (iframe). Yerel AppBridge denemesi için deneme sayfasının kökeni eklenebilir.
IKAS_CERCEVE_KAYNAKLARI=https://*.myikas.com
